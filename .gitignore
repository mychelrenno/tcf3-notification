# .gitignore - padrão de mercado para projetos Java / Spring Boot / Maven

# Sistema operacional
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDEs e editores
.idea/
*.iml
*.iws
out/
.vscode/
*.code-workspace
*.sublime-workspace
*.sublime-project

# Editor swap / temp
*~
*.swp
*.swo
*.tmp
*.bak

# Java
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven
/target/
dependency-reduced-pom.xml
/reports/
/buildNumber.properties
.mvn/timing.properties
/mvnw
/mvnw.cmd

# Gradle (se aplicável)
.gradle/
/build/

# Eclipse
.project
.classpath
.settings/

# Test / coverage / reports
jacoco.exec
coverage/
**/target/surefire-reports/
**/target/failsafe-reports/
test-results/
reports/

# Logs
*.log
logs/
log/

# JVM crash logs
hs_err_pid*

# Keystores / certificados / segredos
*.jks
*.keystore
*.pem
*.p12
.env
.env.*
credentials.properties
secrets.properties

# Docker
docker-compose.override.yml
docker-compose.*.yml

# Containers / packaging
.Dockerfile.swp

# CI / tooling
.gradle-cache/

# Node / frontend (se houver frontend no repo)
node_modules/
dist/
build/

# Outros
coverage/
.idea_modules/

# Ignore arquivos específicos de configuração local do projeto
/local.properties

# Arquivos do sistema que podem aparecer em Windows
Thumbs.db
Desktop.ini

# Fin

